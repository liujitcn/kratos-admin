{
  "name": "@liujitcn/kratos-taro-app-core",
  "description": "Runtime, navigation, authentication, and build foundation for Kratos Taro apps.",
  "license": "MIT",
  "homepage": "https://github.com/liujitcn/kratos-admin",
  "repository": {
    "type": "git",
    "url": "git@github.com:liujitcn/kratos-admin.git"
  },
  "version": "0.0.24",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./build": {
      "types": "./src/build.ts",
      "import": "./dist/build.mjs",
      "default": "./dist/build.mjs"
    },
    "./runner": "./dist/runner.mjs",
    "./api/*": "./src/api/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./navigation": "./src/navigation.ts",
    "./module": "./src/module.ts",
    "./rpc/*": "./src/rpc/*.ts",
    "./stores": "./src/stores/index.ts",
    "./static/*": "./src/static/*",
    "./styles/*": "./src/styles/*",
    "./utils/*": "./src/utils/*.ts",
    "./views/*": "./src/views/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:entries && pnpm pack --pack-destination ../../dist/npm",
    "build:entries": "esbuild src/build.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/build.mjs && esbuild src/runner.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/runner.mjs",
    "tsc": "tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tarojs/components": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "asmcrypto.js": "2.3.2",
    "go-captcha-react": "1.0.5",
    "react": "18.3.1",
    "typescript": "5.8.3",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@types/react": "18.3.23"
  }
}
