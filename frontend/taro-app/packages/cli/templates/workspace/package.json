{
  "name": "__PROJECT_NAME__",
  "description": "Independent pnpm workspace for __PROJECT_NAME__.",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "prepare:modules": "pnpm --recursive --filter './packages/modules/**' --if-present run build:entries",
    "dev:h5": "pnpm prepare:modules && pnpm --filter @local/kratos-taro-app dev:h5",
    "dev:mp-weixin": "pnpm prepare:modules && pnpm --filter @local/kratos-taro-app dev:mp-weixin",
    "build:h5": "pnpm prepare:modules && pnpm --filter @local/kratos-taro-app build:h5",
    "build:mp-weixin": "pnpm prepare:modules && pnpm --filter @local/kratos-taro-app build:mp-weixin",
    "tsc": "pnpm --recursive --if-present run tsc",
    "test": "node --test",
    "build:packages": "pnpm --recursive --filter './packages/modules/**' run build",
    "check:exports": "pnpm run prepare:modules && node scripts/check-package-exports.mjs",
    "lint": "eslint . --fix --ext .js,.mjs,.ts,.tsx",
    "i18n:sync": "node scripts/sync-locales.mjs --write",
    "i18n:check": "node scripts/sync-locales.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@babel/preset-react": "7.28.5",
    "@types/node": "20.19.9",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "babel-preset-taro": "4.2.1",
    "cross-env": "7.0.3",
    "esbuild": "0.25.8",
    "sass": "1.89.2",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "5.8.3",
    "webpack": "5.91.0",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "eslint": "8.57.1",
    "eslint-config-taro": "4.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "less": "4.8.1",
    "prettier": "3.6.2",
    "ts-proto": "2.7.7",
    "turbo": "2.5.5"
  },
  "pnpm": {
    "overrides": {
      "swiper": "12.1.2",
      "tmp": "0.2.6"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "@tarojs/binding",
      "@tarojs/cli",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@nutui/nutui-react-taro",
      "@parcel/watcher",
      "core-js",
      "core-js-pure"
    ],
    "auditConfig": {
      "ignoreCves": [
        "CVE-2022-25900",
        "CVE-2024-29415",
        "CVE-2025-25975",
        "CVE-2022-37620",
        "CVE-2026-53486",
        "CVE-2026-10732",
        "CVE-2025-71330",
        "CVE-2025-71329",
        "CVE-2026-39243"
      ]
    }
  }
}
