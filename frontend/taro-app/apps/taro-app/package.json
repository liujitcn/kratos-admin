{
  "name": "@liujitcn/kratos-taro-app",
  "description": "Private Taro React host for Kratos H5 and WeChat Mini Program.",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:h5": "node ../../packages/core/dist/runner.mjs --type h5 --watch --mode development",
    "dev:mp-weixin": "node ../../packages/core/dist/runner.mjs --type weapp --watch --mode development",
    "build:h5": "KRATOS_TARO_OUTPUT_ROOT=../../../../backend/data/app KRATOS_TARO_PUBLIC_PATH=/app/ node ../../packages/core/dist/runner.mjs --type h5 --mode production",
    "build:mp-weixin": "node ../../packages/core/dist/runner.mjs --type weapp --mode production",
    "tsc": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@babel/runtime": "7.28.4",
    "@liujitcn/kratos-taro-app-core": "workspace:*",
    "@liujitcn/kratos-taro-app-system": "workspace:*",
    "@liujitcn/kratos-taro-app-ui": "workspace:*",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "0.5.17",
    "@tarojs/cli": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "react-refresh": "0.14.2"
  }
}
