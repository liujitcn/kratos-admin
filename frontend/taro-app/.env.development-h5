# H5 dev server port
VITE_APP_PORT=5002
# 是否启用 H5 HTTPS 开发服务；证书位于仓库根 certs
VITE_APP_HTTPS=false
# VITE_APP_HTTPS_KEY=../../certs/dev-key.pem
# VITE_APP_HTTPS_CERT=../../certs/dev-cert.pem

# H5 base path
VITE_APP_BASE_PATH=/

# API address
VITE_APP_BASE_API=/api

# Backend address
VITE_APP_API_URL=http://localhost:7001

# Static resource base path
VITE_APP_STATIC_API=

# Static resource address
VITE_APP_STATIC_URL=http://localhost:7001
