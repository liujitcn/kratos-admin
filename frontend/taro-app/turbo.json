{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "build:entries": {
      "dependsOn": ["^build:entries"],
      "outputs": ["dist/**"]
    },
    "build:h5": {
      "dependsOn": ["^build:entries"],
      "cache": false,
      "outputs": []
    },
    "build:mp-weixin": {
      "dependsOn": ["^build:entries"],
      "cache": false,
      "outputs": []
    },
    "dev:h5": {
      "dependsOn": ["^build:entries"],
      "cache": false,
      "persistent": true
    },
    "dev:mp-weixin": {
      "dependsOn": ["^build:entries"],
      "cache": false,
      "persistent": true
    },
    "tsc": {
      "dependsOn": ["^tsc", "^build:entries"],
      "outputs": []
    }
  }
}
