{
  "name": "kratos-app-workspace",
  "description": "Independent pnpm workspace for the Kratos cross-platform app.",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "prepare:modules": "turbo run build:entries --filter=@liujitcn/kratos-app-system",
    "dev:h5": "turbo run dev:h5 --filter=@liujitcn/kratos-app",
    "dev:mp-weixin": "turbo run dev:mp-weixin --filter=@liujitcn/kratos-app",
    "build:h5": "turbo run build:h5 --filter=@liujitcn/kratos-app",
    "build:mp-weixin": "turbo run build:mp-weixin --filter=@liujitcn/kratos-app",
    "build:packages": "turbo run build --concurrency=1 --filter=@liujitcn/kratos-app-core --filter=@liujitcn/kratos-app-system --filter=@liujitcn/kratos-app-cli",
    "generate:rpc": "make -C ../../backend ts-app",
    "check:exports": "pnpm run prepare:modules && node scripts/check-package-exports.mjs",
    "test": "pnpm run prepare:modules && node --test packages/core/test/*.test.mjs packages/cli/test/*.test.mjs",
    "lint": "eslint . --fix",
    "tsc": "turbo run tsc --filter=@liujitcn/kratos-app"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@rushstack/eslint-patch": "^1.1.4",
    "@uni-helper/uni-app-types": "1.0.0-alpha.6",
    "@uni-helper/uni-ui-types": "1.0.0-alpha.6",
    "@vue/compiler-sfc": "3.4.21",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.8.0",
    "miniprogram-api-typings": "^4.0.5",
    "prettier": "3.6.2",
    "ts-proto": "^2.7.7",
    "turbo": "^2.10.7",
    "typescript": "5.4.5",
    "vue-tsc": "^1.8.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "core-js",
      "core-js-pure",
      "vue-demi"
    ]
  }
}
