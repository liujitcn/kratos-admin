{
  "name": "@liujitcn/kratos-app-core",
  "description": "Runtime, navigation, authentication, and build foundation for Kratos apps.",
  "version": "0.0.1",
  "type": "module",
  "files": ["dist", "src", "README.md"],
  "exports": {
    ".": "./src/index.ts",
    "./module": {
      "types": "./src/module.ts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./api/*": "./src/api/*.ts",
    "./components/*.vue": "./src/components/*.vue",
    "./rpc/*": "./src/rpc/*",
    "./stores": "./src/stores/index.ts",
    "./static/*": "./src/static/*",
    "./styles/base.scss": "./src/styles/base.scss",
    "./uni.scss": "./src/uni.scss",
    "./utils/*": "./src/utils/*.ts",
    "./views/*": "./src/views/*",
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./dist/vite.mjs",
      "default": "./dist/vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:entries && pnpm pack --pack-destination ../../dist/npm",
    "build:entries": "esbuild src/module.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/module.mjs && esbuild src/vite.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/vite.mjs",
    "tsc": "vue-tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-ui": "^1.4.28",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "asmcrypto.js": "^2.3.2",
    "go-captcha-uni": "1.0.6",
    "pinia": "^2.0.27",
    "pinia-plugin-persistedstate": "^3.2.0",
    "vite": "5.2.8",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/node": "^18.11.9",
    "esbuild": "^0.20.2",
    "vue-tsc": "^1.8.8"
  }
}
