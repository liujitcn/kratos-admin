{
  "name": "@liujitcn/kratos-uni-app-system",
  "description": "Kratos uni-app system module with profile, settings, and AI views.",
  "license": "MIT",
  "homepage": "https://github.com/liujitcn/kratos-admin",
  "repository": {
    "type": "git",
    "url": "git@github.com:liujitcn/kratos-admin.git"
  },
  "version": "0.0.20",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./views/*": "./src/views/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:entries && pnpm pack --pack-destination ../../../dist/npm",
    "build:entries": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.mjs",
    "tsc": "vue-tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-ui": "^1.4.28",
    "@liujitcn/kratos-uni-app-core": "workspace:^",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "vue-tsc": "^1.8.8"
  }
}
