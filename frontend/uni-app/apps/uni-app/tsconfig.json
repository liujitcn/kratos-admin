{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "../..",
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": [],
    "paths": {
      "@/*": ["../../packages/core/src/*"],
      "@system/*": ["../../packages/modules/system/src/*"],
      "@liujitcn/kratos-uni-app-core": ["../../packages/core/src/index.ts"],
      "@liujitcn/kratos-uni-app-core/*": ["../../packages/core/src/*"],
      "@liujitcn/kratos-uni-app-system": ["../../packages/modules/system/src/index.ts"],
      "@liujitcn/kratos-uni-app-system/*": ["../../packages/modules/system/src/*"]
    }
  },
  "include": [
    "*.ts",
    "*.d.ts",
    "*.uvue",
    "pages/**/*.uvue",
    "pagesMember/**/*.uvue"
  ]
}
