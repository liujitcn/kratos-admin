{
  "name": "@liujitcn/kratos-uni-app",
  "description": "Private uni-app host for Kratos H5 and WeChat Mini Program.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "recover:pages": "node -e \"import('@liujitcn/kratos-uni-app-core/vite').then(({ recoverStalePageTransaction }) => recoverStalePageTransaction())\"",
    "dev:h5": "pnpm run recover:pages && uni --mode development-h5",
    "dev:mp-weixin": "pnpm run recover:pages && uni -p mp-weixin --mode development",
    "build:h5": "pnpm run recover:pages && UNI_OUTPUT_DIR=../../../../backend/data/uni-app uni build --mode production-h5",
    "build:mp-weixin": "pnpm run recover:pages && uni build -p mp-weixin --mode production",
    "tsc": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-components": "3.0.0-5010520260709002",
    "@dcloudio/uni-h5": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5010520260709002",
    "@dcloudio/uni-ui": "^1.4.28",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "@liujitcn/kratos-uni-app-core": "workspace:*",
    "@liujitcn/kratos-uni-app-system": "workspace:*",
    "pinia": "^2.0.27",
    "sass": "1.77.8",
    "vite": "5.2.8",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/node": "^18.11.9",
    "vue-tsc": "^1.8.8"
  }
}
