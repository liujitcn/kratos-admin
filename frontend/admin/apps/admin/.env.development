# 本地环境
VITE_USER_NODE_ENV = development

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = hash

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 是否开启 VitePWA
VITE_PWA = false

# 开发环境接口地址
VITE_API_URL = /api

# 开发环境跨域代理，支持配置多个
VITE_PROXY = [["/api","http://localhost:7001"],["/events","http://localhost:7001"],["/data","http://localhost:7001"]]

# 是否启用 HTTPS 开发服务；开启前请先在仓库根目录运行 scripts/generate-dev-cert.sh
VITE_HTTPS = false
# 证书位于仓库根 certs，由后端、Admin、Taro、uni-app 共享
# VITE_HTTPS_KEY = ../../../../certs/dev-key.pem
# VITE_HTTPS_CERT = ../../../../certs/dev-cert.pem
