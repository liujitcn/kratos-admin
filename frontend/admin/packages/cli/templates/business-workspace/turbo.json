{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:package": {
      "dependsOn": ["^build:package"],
      "outputs": ["dist/package/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "type:check": {
      "dependsOn": ["^type:check"],
      "outputs": []
    }
  }
}
