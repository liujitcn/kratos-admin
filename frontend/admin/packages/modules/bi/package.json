{
  "name": "@liujitcn/kratos-admin-bi",
  "private": false,
  "version": "0.1.12",
  "type": "module",
  "description": "kratos-admin BI analysis and semantic query module",
  "license": "MIT",
  "homepage": "https://github.com/liujitcn/kratos-admin",
  "repository": {
    "type": "git",
    "url": "git@github.com:liujitcn/kratos-admin.git"
  },
  "scripts": {
    "build": "pnpm build:package",
    "build:package": "node ../../../scripts/build-package.mjs .",
    "test": "node --test tests/*.test.mjs",
    "type:check": "vue-tsc --noEmit --skipLibCheck",
    "prepack": "pnpm build:package"
  },
  "dependencies": {
    "@liujitcn/kratos-admin-core": "workspace:*",
    "@liujitcn/kratos-admin-system": "workspace:*",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "echarts": "^6.1.0"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^14.3.0",
    "element-plus": "^2.7.6",
    "vue": "^3.5.35",
    "vue-router": "^5.0.7"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/package/declarations/index.d.ts",
      "default": "./dist/package/src/index.ts"
    },
    "./api/*": {
      "types": "./dist/package/declarations/src/api/*.d.ts",
      "default": "./dist/package/src/api/*.ts"
    },
    "./rpc/*": {
      "types": "./dist/package/declarations/src/rpc/*.d.ts",
      "default": "./dist/package/src/rpc/*.ts"
    },
    "./views/*": {
      "types": "./dist/package/declarations/src/views/*.d.ts",
      "default": "./dist/package/src/views/*"
    },
    "./locales/*": "./dist/package/src/locales/*",
    "./module": {
      "types": "./dist/package/declarations/src/module.d.ts",
      "default": "./dist/package/src/module.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/package",
    "package.json",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
