{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@liujitcn/kratos-admin-system": ["src/index.ts"],
      "@liujitcn/kratos-admin-system/config": ["src/config/index.ts"],
      "@liujitcn/kratos-admin-system/api/*": ["src/api/*"],
      "@liujitcn/kratos-admin-system/components/*": ["src/components/*"],
      "@liujitcn/kratos-admin-system/package.json": ["package.json"],
      "@liujitcn/kratos-admin-system/rpc/*": ["src/rpc/*"]
    },
    "rootDir": ".",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "./dist/declarations",
    "declarationDir": "./dist/declarations"
  }
}
