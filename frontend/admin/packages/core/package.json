{
  "name": "@liujitcn/kratos-admin-core",
  "private": false,
  "version": "0.0.25",
  "type": "module",
  "description": "kratos-admin frontend runtime and base modules",
  "author": {
    "name": "Admin",
    "email": "liujitcn@gmail.com",
    "url": "https://github.com/liujitcn"
  },
  "license": "MIT",
