    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.7.2",
    "code-inspector-plugin": "^1.5.1",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.5",
    "driver.js": "^1.3.1",
    "echarts": "^5.5.1",
    "echarts-liquidfill": "^3.1.0",
    "element-plus": "^2.7.6",
    "go-captcha-vue": "2.0.6",
    "highlight.js": "^11.11.1",
    "md-editor-v3": "^6.5.5",
    "md5": "^2.3.0",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.12.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "screenfull": "^6.0.2",
    "sortablejs": "^1.15.2",
    "terser": "^5.48.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-setup-extend-plus": "^1.0.1",
    "vite": "^8.0.14",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue": "^3.5.35",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.7",
    "vuedraggable": "^4.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "browserslist": {
    "production": [
      "> 1%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/package/declarations/index.d.ts",
      "default": "./dist/package/src/index.ts"
    },
    "./api/*": {
      "types": "./dist/package/declarations/src/api/*.d.ts",
      "default": "./dist/package/src/api/*.ts"
    },
    "./assets/*": "./dist/package/src/assets/*",
    "./rpc/*": {
      "types": "./dist/package/declarations/src/rpc/*.d.ts",
      "default": "./dist/package/src/rpc/*.ts"
    },
    "./styles/*.scss": "./dist/package/src/styles/*.scss",
    "./auth": {
      "types": "./dist/package/declarations/src/auth.d.ts",
      "default": "./dist/package/src/auth.ts"
    },
    "./components/Dialog/FormDialog.vue": {
