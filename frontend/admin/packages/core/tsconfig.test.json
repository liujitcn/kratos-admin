  "compilerOptions": {
    "declaration": false,
    "noEmit": false,
    "outDir": "dist/test",
    "rootDir": ".",
    "types": ["vite/client", "element-plus/global", "node"]
  },
  "include": [
    "types/generated/auto-imports.d.ts",
