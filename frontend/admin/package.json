{
  "name": "kratos-admin-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@liujitcn/kratos-admin",
    "build": "turbo run build --filter=@liujitcn/kratos-admin",
    "build:package": "turbo run build:package --filter=@liujitcn/kratos-admin-core --filter=@liujitcn/kratos-admin-system --filter=@liujitcn/kratos-admin-cli",
    "generate:auto-import-types": "node scripts/generate-auto-import-types.mjs",
    "test": "pnpm --filter @liujitcn/kratos-admin-core test && pnpm --filter @liujitcn/kratos-admin-system test && pnpm --filter @liujitcn/kratos-admin-cli test",
    "type:check": "turbo run type:check",
    "lint:oxlint": "oxlint --fix --vue-plugin --config ./internal/lint-config/oxlint.json --ignore-path .oxlintignore ./apps ./packages ./internal ./scripts",
    "lint:prettier": "prettier --write \"{apps,packages,internal,scripts}/**/*.{js,mjs,ts,json,tsx,css,less,scss,vue,html,md,yaml}\"",
    "lint:stylelint": "stylelint --cache --fix \"{apps,packages}/**/*.{vue,less,postcss,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "lint:lint-staged": "lint-staged",
    "module:create": "pnpm --filter @liujitcn/kratos-admin-cli build && node packages/cli/dist/index.js create"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@types/md5": "^2.3.5",
    "@types/node": "^25.9.1",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.9.15",
    "@types/sortablejs": "^1.15.8",
    "autoprefixer": "^10.4.19",
    "cz-git": "1.13.1",
    "czg": "^1.13.1",
    "lint-staged": "^15.2.5",
    "oxlint": "^1.67.0",
    "postcss": "^8.4.38",
    "postcss-html": "^1.8.1",
    "prettier": "^3.3.2",
    "sass": "^1.100.0",
    "standard-version": "^9.5.0",
    "stylelint": "^17.12.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "8.1.1",
    "ts-proto": "^2.11.8",
    "turbo": "^2.5.6",
    "typescript": "6.0.3",
    "vite": "^8.0.14",
    "vue-tsc": "^3.3.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "svg-baker>braces": "3.0.3",
      "svg-baker>micromatch": "4.0.8",
      "svg-baker>postcss": "8.5.15"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "es5-ext",
      "esbuild",
      "vue-demi",
      "workbox-build"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
